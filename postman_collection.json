          }
        },
        {
          "name": "GET Loans - Filter Status Terlambat",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans?status=Terlambat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans"],
              "query": [
                {
                  "key": "status",
                  "value": "Terlambat"
