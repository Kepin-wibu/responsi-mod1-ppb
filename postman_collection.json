              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"member_id\": \"{{sampleMemberId}}\",\n  \"book_id\": \"{{sampleBookId}}\",\n  \"due_date\": \"2026-10-25\",\n  \"notes\": \"Peminjaman untuk bahan riset\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans"]
            }
          }
        },
        {
          "name": "PUT Update Loan / Process Return (Pengembalian Buku)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Dikembalikan\",\n  \"notes\": \"Buku sudah dikembalikan dalam kondisi bersih\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{sampleLoanId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "{{sampleLoanId}}"]
            }
          }
        },
        {
          "name": "DELETE Loan",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
